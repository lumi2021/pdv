<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pdv.Desktop.ViewModels"
             x:Class="Pdv.Desktop.Views.CelularView"
             x:DataType="vm:CelularViewModel">

  <StackPanel Spacing="16" MaxWidth="640" HorizontalAlignment="Left">

    <StackPanel>
      <TextBlock Text="Celular do garçom" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Conecte o celular a este computador pelo Wi-Fi" FontSize="16" Opacity="0.7" />
    </StackPanel>

    <!-- Servidor ligado: QR Code de pareamento -->
    <Border IsVisible="{Binding Ativo}" Background="#ECFDF5" CornerRadius="8" Padding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="Servidor ligado" FontWeight="SemiBold" Foreground="#047857" FontSize="16" />
        <TextBlock TextWrapping="Wrap" Foreground="#111827"
                   Text="1. Conecte o celular ao mesmo Wi-Fi deste computador.  2. Abra a câmera do celular e aponte para o QR Code.  3. Digite o seu nome e pronto." />

        <Border Background="White" CornerRadius="8" Padding="12" HorizontalAlignment="Left">
          <Image Source="{Binding QrCode}" Width="220" Height="220" />
        </Border>

        <StackPanel Spacing="2">
          <TextBlock Text="Sem câmera? Abra o endereço abaixo no navegador do celular e digite o código:" TextWrapping="Wrap" Foreground="#111827" />
          <ItemsControl ItemsSource="{Binding Enderecos}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <SelectableTextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" Foreground="#111827" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <SelectableTextBlock Text="{Binding Codigo}" FontSize="28" FontWeight="Bold" Foreground="#111827" FontFamily="Consolas,Menlo,monospace" />
          <TextBlock Text="{Binding Validade}" FontSize="13" Foreground="#111827" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <Button Content="Gerar novo código" Command="{Binding NovoCodigoCommand}" HorizontalAlignment="Left" />

        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#111827" Opacity="0.7"
                   Text="Se aparecer mais de um endereço, use o que começa com 192.168 ou 10. Se o celular não abrir a página, o Windows pode estar bloqueando: quando ele perguntar, permita o PDV Lanchonete em redes privadas." />
      </StackPanel>
    </Border>

    <!-- Celulares conectados -->
    <StackPanel IsVisible="{Binding Ativo}" Spacing="8">
      <TextBlock Text="Celulares conectados" FontSize="20" FontWeight="SemiBold" />
      <TextBlock IsVisible="{Binding SemCelulares}" Opacity="0.7" Text="Nenhum celular conectado ainda." />
      <ItemsControl ItemsSource="{Binding Celulares}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DispositivoItem">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <StackPanel>
                <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding Descricao}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="Desconectar" VerticalAlignment="Center"
                      Command="{Binding $parent[UserControl].((vm:CelularViewModel)DataContext).DesconectarCommand}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Servidor com falha -->
    <Border IsVisible="{Binding ComFalha}" Background="#FEE2E2" CornerRadius="8" Padding="16">
      <StackPanel Spacing="8">
        <TextBlock Text="O servidor do celular não ligou" FontWeight="SemiBold" Foreground="#991B1B" FontSize="16" />
        <TextBlock TextWrapping="Wrap"
                   Text="O resto do sistema funciona normalmente. Verifique se outro programa não está usando a rede e tente de novo." />
        <TextBlock Text="{Binding DetalhesErro}" TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
        <Button Content="Tentar novamente" Command="{Binding TentarNovamenteCommand}" />
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>

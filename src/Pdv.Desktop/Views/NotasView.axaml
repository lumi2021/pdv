<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pdv.Desktop.ViewModels"
             x:Class="Pdv.Desktop.Views.NotasView"
             x:DataType="vm:NotasViewModel">

  <Grid ColumnDefinitions="*,24,380" RowDefinitions="Auto,Auto,*">

    <StackPanel Grid.Row="0" Grid.ColumnSpan="3">
      <TextBlock Text="Notas" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Notas internas dos pedidos entregues (sem valor fiscal)" FontSize="16" Opacity="0.7" />
    </StackPanel>

    <Border Grid.Row="1" Grid.ColumnSpan="3" IsVisible="{Binding TemMensagem}" Background="#E0F2FE"
            CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Mensagem}" Foreground="#0C4A6E" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="OK" Command="{Binding FecharMensagemCommand}" Margin="12,0,0,0" />
      </Grid>
    </Border>

    <!-- Lista -->
    <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBox Text="{Binding Busca}" Watermark="Procurar por número, mesa ou cliente" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Periodos}" SelectedItem="{Binding PeriodoSelecionado}"
                  Margin="8,0,0,0" MinWidth="150">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PeriodoNotas">
              <TextBlock Text="{Binding Nome}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </Grid>

      <TextBlock DockPanel.Dock="Top" IsVisible="{Binding ListaVazia}" Opacity="0.6" Margin="4,16"
                 Text="Nenhuma nota encontrada. A nota é criada quando um pedido é entregue." TextWrapping="Wrap" />

      <ListBox ItemsSource="{Binding Notas}" SelectedItem="{Binding Selecionada}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NotaLinhaViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="4,6">
              <StackPanel>
                <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitulo}" FontSize="12" Opacity="0.7" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Total}" FontSize="16" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Data}" FontSize="12" Opacity="0.6" HorizontalAlignment="Right" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Nota aberta -->
    <Border Grid.Row="2" Grid.Column="2" Margin="0,16,0,0" Background="#14808080" CornerRadius="8" Padding="16">
      <Grid>
        <TextBlock IsVisible="{Binding SemDetalhe}" Opacity="0.6" TextWrapping="Wrap"
                   Text="Escolha uma nota na lista para ver os detalhes e exportar em PDF." />

        <ScrollViewer IsVisible="{Binding TemDetalhe}">
          <StackPanel Spacing="8" DataContext="{Binding Detalhe}" x:DataType="vm:NotaAbertaViewModel">
            <TextBlock Text="{Binding Titulo}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Pedido}" />
            <TextBlock Text="{Binding Emissao}" Opacity="0.7" FontSize="13" />

            <Separator Margin="0,4" />

            <ItemsControl ItemsSource="{Binding Itens}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemDaNotaViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <StackPanel>
                      <TextBlock Text="{Binding Texto}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Observacao}" IsVisible="{Binding TemObservacao}" FontSize="12"
                                 FontStyle="Italic" Opacity="0.7" Margin="16,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Valor}" Margin="12,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Margin="0,4" />

            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Total" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="18" FontWeight="SemiBold" />
            </Grid>

            <TextBlock Text="{Binding Observacao}" IsVisible="{Binding TemObservacao}" FontSize="13" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Aviso}" FontSize="12" FontStyle="Italic" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0" />

            <Button Classes="accent" Content="Exportar PDF" Click="ExportarPdf_Click" Margin="0,8,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>

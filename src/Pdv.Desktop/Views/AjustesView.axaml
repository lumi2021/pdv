<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pdv.Desktop.ViewModels"
             x:Class="Pdv.Desktop.Views.AjustesView"
             x:DataType="vm:AjustesViewModel">

  <ScrollViewer>
    <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Left">

      <StackPanel>
        <TextBlock Text="Ajustes" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Nome do negócio e cópias de segurança" FontSize="16" Opacity="0.7" />
      </StackPanel>

      <Border IsVisible="{Binding TemMensagem}" Background="#E0F2FE" CornerRadius="6" Padding="12,8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Mensagem}" Foreground="#0C4A6E" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="OK" Command="{Binding FecharMensagemCommand}" Margin="12,0,0,0" />
        </Grid>
      </Border>

      <!-- Nome -->
      <StackPanel Spacing="8">
        <TextBlock Text="Nome do negócio" FontSize="20" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding NomeDoNegocio}" MaxLength="60" />
          <Button Grid.Column="1" Content="Salvar" Command="{Binding SalvarNomeCommand}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Opacity="0.7" Text="Aparece nas notas em PDF." />
      </StackPanel>

      <!-- Backup -->
      <StackPanel Spacing="8">
        <TextBlock Text="Cópias de segurança" FontSize="20" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="O sistema guarda uma cópia dos seus dados todos os dias e também antes de cada atualização. As mais antigas são apagadas sozinhas." />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="accent" Content="Fazer uma cópia agora" Command="{Binding FazerBackupCommand}"
                  IsEnabled="{Binding !Ocupado}" />
          <Button Content="Abrir pasta das cópias" Command="{Binding AbrirPastaDeBackupsCommand}" />
        </StackPanel>

        <TextBlock IsVisible="{Binding SemBackups}" Opacity="0.6" Text="Ainda não há cópias." />
        <ItemsControl ItemsSource="{Binding Backups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:BackupLinha">
              <StackPanel Margin="0,4">
                <TextBlock Text="{Binding Titulo}" />
                <TextBlock Text="{Binding Detalhe}" FontSize="12" Opacity="0.6" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Como voltar para uma cópia antiga">
          <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                     Text="1. Feche o PDV.  2. Abra a pasta dos dados (abaixo).  3. Apague os arquivos pdv.db, pdv.db-wal e pdv.db-shm.  4. Copie para lá o arquivo da cópia que você quer e renomeie para pdv.db.  5. Abra o PDV de novo. Os pedidos feitos depois dessa cópia serão perdidos; por segurança, faça antes uma cópia da situação atual." />
        </Expander>
      </StackPanel>

      <!-- Pastas -->
      <StackPanel Spacing="8">
        <TextBlock Text="Para quem dá suporte" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Pasta dos dados:" FontSize="13" Opacity="0.7" />
        <SelectableTextBlock Text="{Binding PastaDosDados}" FontSize="13" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Versao, StringFormat='Versão {0}'}" FontSize="13" Opacity="0.7" />
        <Button Content="Abrir pasta de registros (erros)" Command="{Binding AbrirPastaDeRegistrosCommand}"
                HorizontalAlignment="Left" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>

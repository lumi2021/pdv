<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pdv.Core\Pdv.Core.csproj" />
  </ItemGroup>

  <!-- A página do garçom vai dentro do executável: nada para copiar nem instalar. Arquivos soltos, sem subpastas. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\*" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
